# Copy to .env and fill in. Never commit .env.

# Shared: read by fd-engine and fd-demo-agent settings through an alias
OPENAI_API_KEY=

# fd-database
FD_DATABASE_URL=postgresql+asyncpg://fd:fd@localhost:5432/first_domino

# fd-engine: model ids are chosen at the event and live only here
FD_ENGINE_STRONG_MODEL=

# fd-api
FD_API_CLERK_ISSUER=
FD_API_CLERK_JWKS_URL=

# fd-demo-agent (the demo customer)
FD_DEMO_AGENT_MODEL=
FIRST_DOMINO_API_KEY=
FIRST_DOMINO_BASE_URL=http://localhost:8000
