# Public, non-secret settings for production builds (Next.js loads this for `next build`).
# Never put a secret here: this file is committed. Secrets live in Vercel:
# AUTH_SECRET, AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET, API_JWT_SECRET.
NEXT_PUBLIC_APP_URL=https://first-domino.abhiramtech.in
NEXT_PUBLIC_API_URL=https://api-first-domino.abhiramtech.in
AUTH_URL=https://first-domino.abhiramtech.in
APP_ENV=prod
LOG_LEVEL=info
DD_SERVICE=first-domino-web
