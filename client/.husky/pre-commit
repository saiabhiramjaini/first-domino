# Formats and lints the staged files of each half, then re-stages what was fixed.
# Git runs hooks from the repository root.
set -e
export PATH="$HOME/.bun/bin:$HOME/.local/bin:/opt/homebrew/bin:$PATH"

staged=$(git diff --cached --name-only --diff-filter=ACMR)

server_files=$(printf '%s\n' "$staged" | grep -E '^server/.*\.py$' | sed 's#^server/##' || true)
if [ -n "$server_files" ]; then
  echo "ruff (server)"
  (cd server && uv run --quiet ruff format --force-exclude $server_files && uv run --quiet ruff check --fix --force-exclude $server_files)
  printf '%s\n' "$server_files" | sed 's#^#server/#' | xargs git add
fi

client_files=$(printf '%s\n' "$staged" | grep -E '^client/.*\.(ts|tsx|js|jsx|mjs|cjs|json|css|md)$' | grep -v '^client/src/api/generated/' | sed 's#^client/##' || true)
if [ -n "$client_files" ]; then
  echo "prettier (client)"
  (cd client && bunx prettier --write --log-level warn $client_files)
  printf '%s\n' "$client_files" | sed 's#^#client/#' | xargs git add
fi
