# Copy to deploy/.env on the host and fill in. Never commit deploy/.env.

# The public name: <elastic IP with dots>.sslip.io, or localhost to try it on a laptop
FD_DOMAIN=localhost

# Postgres (only reachable inside the compose network)
POSTGRES_PASSWORD=

# Shared by the web app (signs session tokens) and the API (verifies them): openssl rand -hex 32
API_JWT_SECRET=

# Web app sign-in (NextAuth with Google)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Engine and demo agent models
OPENAI_API_KEY=
FD_ENGINE_STRONG_MODEL=
FD_DEMO_AGENT_MODEL=

# The demo worker's project API key, printed by `make seed-demo` (see README)
FIRST_DOMINO_API_KEY=
