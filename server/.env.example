# Copy to .env and fill in. Never commit .env.

# Read by fd-engine settings through an alias
OPENAI_API_KEY=

# fd-database
FD_DATABASE_URL=postgresql+asyncpg://fd:fd@localhost:5432/first_domino

# fd-engine: model ids are chosen at the event and live only here
FD_ENGINE_STRONG_MODEL=
# Optional: the model that judges replays of flagged runs (default: the strong model), and its
# temperature (default: none sent, which reasoning models require).
# FD_ENGINE_JUDGE_MODEL=
# FD_ENGINE_JUDGE_TEMPERATURE=

# fd-api
# Same value as API_JWT_SECRET in client/.env.local
FD_API_WEB_JWT_SECRET=
# Base URL of the web app, for links in alerts
FD_API_WEB_APP_URL=http://localhost:3000

