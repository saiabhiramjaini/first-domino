# The demo customer (an "Equal AI (demo)" call assistant) using the live First Domino, the way a
# real customer would. Copy to .env.customer (ignored by git) and fill in. Used by
# `make customer-worker` and `make customer-demo`; these values win over server/.env.
FIRST_DOMINO_BASE_URL=https://api-first-domino.abhiramtech.in
# The project API key from seed_demo on the live API
FIRST_DOMINO_API_KEY=
FD_DEMO_AGENT_WEB_URL=https://first-domino.abhiramtech.in
FD_DEMO_AGENT_MODEL=gpt-4.1-mini
# The customer's own OpenAI key: their agent runs on their machine
OPENAI_API_KEY=
