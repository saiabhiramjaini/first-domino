# Production settings for the EC2 server. Put the filled-in file in the SERVER_ENV GitHub
# secret; the deploy workflow writes it to ~/first-domino/.env and adds IMAGE and IMAGE_TAG.
# Never commit the filled-in file. Avoid `$` in values: Docker Compose reads it as a variable.

# Docker Compose
API_DOMAIN=api.first-domino.abhiram.tech
# Leave empty at first. After `seed-demo` prints FIRST_DOMINO_API_KEY, set this to demo.
COMPOSE_PROFILES=

# Database: the Neon *direct* host (not the -pooler one), with ssl=require for asyncpg
FD_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST.neon.tech/neondb?ssl=require
FD_DATABASE_POOL_SIZE=5
FD_DATABASE_MAX_OVERFLOW=5

# Models
OPENAI_API_KEY=
FD_ENGINE_STRONG_MODEL=gpt-5.5
FD_DEMO_AGENT_MODEL=gpt-4.1-mini

# API. FD_API_WEB_JWT_SECRET must equal API_JWT_SECRET in Vercel.
FD_API_WEB_JWT_SECRET=
FD_API_CORS_ORIGINS=["https://first-domino.abhiram.tech"]
FD_API_WEB_APP_URL=https://first-domino.abhiram.tech
FD_API_LOG_JSON=true

# Demo customer
FD_DEMO_AGENT_WEB_URL=https://first-domino.abhiram.tech
FIRST_DOMINO_API_KEY=
