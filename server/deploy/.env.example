# Production secrets for the EC2 server. Fill in a copy (server/deploy/.env.production is
# ignored by git), store it as the SERVER_ENV GitHub secret, then delete the copy.
# Non-secret settings live in config.env. Avoid `$` in values: Docker Compose reads it as a
# variable.

# Neon *direct* host (not the -pooler one), with ssl=require for asyncpg
FD_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST.neon.tech/neondb?ssl=require
OPENAI_API_KEY=
# Must equal API_JWT_SECRET in Vercel
FD_API_WEB_JWT_SECRET=
# Printed by seed_demo after the first deploy; leave empty until then
FIRST_DOMINO_API_KEY=
