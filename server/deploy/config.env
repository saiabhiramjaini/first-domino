# Non-secret production settings for the EC2 server. Committed on purpose: never put a
# secret here. The deploy workflow joins this file with the SERVER_ENV secret
# (see .env.example) into ~/first-domino/.env. A value in SERVER_ENV wins over one here.

# Docker Compose
API_DOMAIN=api-first-domino.abhiramtech.in
# Set to demo once FIRST_DOMINO_API_KEY is in SERVER_ENV, to start the demo worker.
COMPOSE_PROFILES=

# Database pool (the URL is a secret)
FD_DATABASE_POOL_SIZE=5
FD_DATABASE_MAX_OVERFLOW=5

# Models
FD_ENGINE_STRONG_MODEL=gpt-5.5
FD_DEMO_AGENT_MODEL=gpt-4.1-mini

# API
FD_API_CORS_ORIGINS=["https://first-domino.abhiramtech.in"]
FD_API_WEB_APP_URL=https://first-domino.abhiramtech.in
FD_API_LOG_JSON=true

# Demo customer
FD_DEMO_AGENT_WEB_URL=https://first-domino.abhiramtech.in
